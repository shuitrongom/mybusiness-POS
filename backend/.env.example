# Variables de entorno del backend (copiar a .env y ajustar). NO subir .env al repo.

# Perfil activo: dev | prod
SPRING_PROFILES_ACTIVE=dev

# Conexión a la base de datos
DB_URL=jdbc:postgresql://localhost:5544/mybusiness_silva
DB_USERNAME=pos_app
DB_PASSWORD=pos_app_dev

# Pool de conexiones
DB_POOL_MAX=10
DB_POOL_MIN=2

# Servidor
SERVER_PORT=8080

# Nivel de log de la aplicación
LOG_LEVEL_APP=DEBUG

# ---------------------------------------------------------------------------
# PRODUCCION (dominio real puntonubepos.com). En Railway se definen asi:
#   SPRING_PROFILES_ACTIVE=prod
#   DB_URL=jdbc:postgresql://<host-neon>/<db>?sslmode=require   (de Neon)
#   DB_USERNAME=<usuario-neon>
#   DB_PASSWORD=<password-neon>
#   JWT_SECRET=<cadena-larga-aleatoria-min-64-chars>
#   CORS_ALLOWED_ORIGINS=https://app.puntonubepos.com
#   PORT lo inyecta Railway automaticamente (no definirlo a mano)
# ---------------------------------------------------------------------------
